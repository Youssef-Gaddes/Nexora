{% extends 'base.html.twig' %}

{% block title %}Portfolios - Nexora{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-heading">
            {{ app.session.get('role') == 'ADMIN' ? 'Manage Portfolios' : 'My Performance Portfolio' }}
            <span class="badge badge-purple-soft" style="font-size: 0.8rem; vertical-align: middle; margin-left: 12px; height: fit-content; padding: 5px 12px;">
                <i class="fas fa-medal mr-1"></i> Verified Market Standing
            </span>
        </h1>
        {% if app.session.get('role') == 'ADMIN' %}
        <button class="btn btn-primary" onclick="document.getElementById('addPortfolioModal').style.display='block'">
            <i class="fas fa-plus"></i> New Portfolio
        </button>
        {% endif %}
    </div>

    {% if app.session.get('role') == 'ADMIN' %}
    <div class="stats-row mb-4">
        <div class="stat-card">
            <div class="stat-icon purple"><i class="fas fa-briefcase"></i></div>
            <div class="stat-info">
                <span class="stat-label">Total Portfolios Value</span>
                <span class="stat-value text-success">{{ totalValue|number_format(2) }} DT</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-folder"></i></div>
            <div class="stat-info">
                <span class="stat-label">Active Portfolios</span>
                <span class="stat-value">{{ activeCount }}</span>
            </div>
        </div>
    </div>

    <div class="data-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3>Registered Portfolios</h3>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User ID</th>
                        <th>Total Value (TND)</th>
                        <th>Assets Count</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for portfolio in portfolios %}
                    <tr class="wallet-row">
                        <td><span class="id-badge">#P{{ portfolio.id }}</span></td>
                        <td>
                            <div class="owner-cell">
                                <div class="owner-avatar"><i class="fas fa-user"></i></div>
                                <span>User #{{ portfolio.user ? portfolio.user.id : 'N/A' }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="price-text text-success">
                                {{ portfolio.totalValue|number_format(2) }} DT
                            </span>
                        </td>
                        <td>{{ portfolio.portfolioAssets|length }} asset(s)</td>
                        <td class="text-right d-flex justify-content-end gap-2">
                            <button class="btn-icon edit" title="Edit"
                                onclick="openEditModal({{ portfolio.id }}, '{{ portfolio.user ? portfolio.user.id : '' }}', '{{ portfolio.totalValue }}')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <form action="{{ path('portfolio_delete', {'id': portfolio.id}) }}" method="POST" onsubmit="return confirm('Delete this portfolio?')">
                                <button type="submit" class="btn-icon delete" title="Delete"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="empty-state">
                                <i class="fas fa-folder-open"></i>
                                <p>No portfolios found.</p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% else %}
    {# ── USER PORTFOLIO DASHBOARD ── #}
    {% set myPortfolio = portfolios|first %}
    {% if myPortfolio %}

    {# Hero banner #}
    <div class="nexora-holo-card nexora-glow-indigo mb-4" style="min-height: 200px;">
        <div class="nexora-holo-content d-flex justify-content-between align-items-center">
        <div>
            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 0.4rem;">Total Portfolio Value</div>
            <div style="font-size: 3rem; font-weight: 800; color: var(--text-main); line-height: 1;">
                {{ myPortfolio.totalValue|number_format(2) }}
                <span style="font-size: 1.4rem; color: var(--accent); font-weight: 500;"> TND</span>
            </div>
            <div style="margin-top: 0.8rem; font-size: 0.85rem; color: var(--text-muted);">
                <i class="fas fa-layer-group" style="margin-right: 6px; color: var(--accent);"></i>
                {{ myPortfolio.portfolioAssets|length }} asset(s) held
            </div>
        </div>
        <div style="display: flex; gap: 1rem;">
            <a href="{{ path('order_index') }}" class="btn btn-primary" style="border-radius: 50px; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-bolt"></i> Trade Now
            </a>
            <a href="{{ path('p2p_contract_index') }}" class="btn" style="border-radius: 50px; background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-handshake"></i> P2P Market
            </a>
            <a href="{{ path('portfolio_report_pdf', {'id': myPortfolio.id}) }}" class="btn" style="border-radius: 50px; background: rgba(168,85,247,0.15); color: #a855f7; border: 1px solid rgba(168,85,247,0.3); display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-file-pdf"></i> Generate Report
            </a>
        </div>
    </div>
    </div>

    {# ── Nexora AI Advisor ── #}
    {% if aiAdvice %}
    <div class="nexora-holo-card mb-4">
        <div class="nexora-holo-content">
        {# Animated background glow #}
        <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: {{ aiAdvice.sentiment == 'BULLISH' ? '#10b98122' : (aiAdvice.sentiment == 'BEARISH' ? '#ef444422' : '#a855f722') }}; filter: blur(40px); border-radius: 50%;"></div>
        
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
            <div style="width: 50px; height: 50px; border-radius: 15px; background: linear-gradient(135deg, #6366f1, #a855f7); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 16px rgba(99,102,241,0.3);">
                <i class="fas fa-brain" style="color: white; font-size: 1.2rem;"></i>
            </div>
            <div>
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Nexora AI Advisor</h3>
                <div style="font-size: 0.75rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #10b981;"></span>
                    Local Intelligence Engine Active
                </div>
            </div>
            <div style="margin-left: auto; display: flex; gap: 10px;">
                <div style="background: rgba(255,255,255,0.04); padding: 5px 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); text-align: center;">
                    <div style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase;">Sentiment</div>
                    <div style="font-size: 0.85rem; font-weight: 700; color: {{ aiAdvice.sentiment == 'BULLISH' ? '#10b981' : (aiAdvice.sentiment == 'BEARISH' ? '#ef4444' : '#a855f7') }};">{{ aiAdvice.sentiment }}</div>
                </div>
                <div style="background: rgba(255,255,255,0.04); padding: 5px 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); text-align: center;">
                    <div style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase;">Risk Level</div>
                    <div style="font-size: 0.85rem; font-weight: 700; color: {{ aiAdvice.risk_level == 'Low' ? '#10b981' : (aiAdvice.risk_level == 'High' ? '#ef4444' : '#f59e0b') }};">{{ aiAdvice.risk_level }}</div>
                </div>
            </div>
        </div>
        
        <div style="background: rgba(255,255,255,0.03); border-radius: 15px; padding: 1.2rem; border-left: 4px solid {{ aiAdvice.sentiment == 'BULLISH' ? '#10b981' : (aiAdvice.sentiment == 'BEARISH' ? '#ef4444' : '#a855f7') }};">
            <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-main);">
                {{ aiAdvice.advice }}
            </p>
        </div>
        
        <div style="margin-top: 1rem; font-size: 0.7rem; color: var(--text-muted); text-align: right;">
            Data sourced from **CoinGecko** & **Frankfurter API** &bull; Analysis by **Naive Bayes Classifier (v1.0)**
        </div>
    </div>
    {% endif %}

    {% if myPortfolio.portfolioAssets|length > 0 %}
    {# Charts row #}
    <div style="display: grid; grid-template-columns: 1fr 1.8fr; gap: 1.5rem; margin-bottom: 2rem;">

        {# Donut Allocation Chart #}
        <div class="data-card shadow-sm" style="padding: 1.8rem; background: var(--bg-card); border-radius: 20px; border: 1px solid rgba(255,255,255,0.06);">
            <div style="font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 1.2rem;">
                <i class="fas fa-chart-pie" style="color: var(--accent); margin-right: 8px;"></i>Allocation
            </div>
            <div style="position: relative; height: 220px; display: flex; align-items: center; justify-content: center;">
                <canvas id="allocationChart"></canvas>
                <div style="position: absolute; text-align: center; pointer-events: none;">
                    <div style="font-size: 0.7rem; color: var(--text-muted);">ASSETS</div>
                    <div style="font-size: 1.8rem; font-weight: 700;">{{ myPortfolio.portfolioAssets|length }}</div>
                </div>
            </div>
            {# Legend #}
            <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;" id="chartLegend"></div>
        </div>

        {# Bar chart: Quantity per asset #}
        <div class="data-card shadow-sm" style="padding: 1.8rem; background: var(--bg-card); border-radius: 20px; border: 1px solid rgba(255,255,255,0.06);">
            <div style="font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 1.2rem;">
                <i class="fas fa-chart-bar" style="color: #10b981; margin-right: 8px;"></i>Holdings Breakdown
            </div>
            <div style="position: relative; height: 220px;">
                <canvas id="holdingsChart"></canvas>
            </div>
        </div>
    </div>
    {% endif %}

    {# Asset cards #}
    <div style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 1rem;">
        <i class="fas fa-coins" style="color: var(--accent); margin-right: 8px;"></i>My Holdings
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        {% set colors = ['#6366f1','#10b981','#f59e0b','#ef4444','#a855f7','#3b82f6','#ec4899','#14b8a6'] %}
        {% for pa in myPortfolio.portfolioAssets %}
            {% set col = colors[loop.index0 % colors|length] %}
            {% set currentMarketValue = pa.quantity * pa.asset.value %}
            {% set costBasis = pa.quantity * pa.avgPrice %}
            {% set profitLoss = currentMarketValue - costBasis %}
            {% set profitPct = costBasis > 0 ? (profitLoss / costBasis * 100) : 0 %}
            
            <div class="nexora-holo-card {{ profitLoss >= 0 ? 'nexora-glow-emerald' : 'nexora-glow-ruby' }}">
                <div class="nexora-holo-content">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.2rem;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 42px; height: 42px; border-radius: 12px; background: {{ col }}22; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-coins" style="color: {{ col }}; font-size: 1.1rem;"></i>
                            </div>
                            <div>
                                <div style="font-weight: 700; font-size: 1rem;">{{ pa.asset.name }}</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">{{ pa.asset.symbol }} &bull; Live: {{ pa.asset.value|number_format(2) }} DT</div>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <span style="font-size: 0.72rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: {{ profitLoss >= 0 ? '#10b98122' : '#ef444422' }}; color: {{ profitLoss >= 0 ? '#10b981' : '#ef4444' }};">
                                {{ profitLoss >= 0 ? '+' : '' }}{{ profitPct|number_format(1) }}%
                            </span>
                        </div>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                        <div>
                            <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Current Value</div>
                            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-main);">{{ currentMarketValue|number_format(2) }} <small style="font-size: 0.7rem; color: var(--text-muted);">DT</small></div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 0.72rem; color: var(--text-muted);">Holdings</div>
                            <div style="font-size: 1rem; font-weight: 700;">{{ pa.quantity }} <small style="font-size: 0.65rem;">units</small></div>
                        </div>
                    </div>
                    
                    <div style="margin-top: 1rem; padding: 0.8rem; background: rgba(255,255,255,0.03); border-radius: 12px; display: flex; justify-content: space-between; font-size: 0.78rem;">
                        <div style="display: flex; flex-direction: column;">
                            <span style="color: var(--text-muted); font-size: 0.65rem; text-transform: uppercase;">Bought At</span>
                            <span style="font-weight: 600;">{{ pa.avgPrice|number_format(2) }} <small>DT</small></span>
                        </div>
                        <div style="display: flex; flex-direction: column; text-align: right;">
                            <span style="color: var(--text-muted); font-size: 0.65rem; text-transform: uppercase;">Profit / Loss</span>
                            <span style="font-weight: 700; color: {{ profitLoss >= 0 ? '#10b981' : '#ef4444' }};">
                                {{ profitLoss >= 0 ? '+' : '' }}{{ profitLoss|number_format(2) }} <small>DT</small>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
        <div class="nexora-holo-card" style="grid-column: 1/-1; text-align: center; padding: 3rem; color: var(--text-muted);">
            <div class="nexora-holo-content">
                <i class="fas fa-folder-open" style="font-size: 3.5rem; opacity: 0.3;"></i>
                <h4 style="margin-top: 1rem;">Your portfolio is empty</h4>
                <p>Go to <a href="{{ path('order_index') }}" style="color: var(--accent);">Spot Trading</a> to buy your first assets.</p>
            </div>
        </div>
        {% endfor %}
    </div>
    </div>

    {# Chart.js data injection #}
    {% if myPortfolio.portfolioAssets|length > 0 %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
    (function() {
        const colors = ['#6366f1','#10b981','#f59e0b','#ef4444','#a855f7','#3b82f6','#ec4899','#14b8a6'];
        const labels = [{% for pa in myPortfolio.portfolioAssets %}'{{ pa.asset.name }}'{% if not loop.last %},{% endif %}{% endfor %}];
        const quantities = [{% for pa in myPortfolio.portfolioAssets %}{{ pa.quantity }}{% if not loop.last %},{% endif %}{% endfor %}];
        const values = [{% for pa in myPortfolio.portfolioAssets %}{{ (pa.quantity * pa.asset.value)|round(2) }}{% if not loop.last %},{% endif %}{% endfor %}];
        const sliceColors = colors.slice(0, labels.length);

        // ── Donut Chart (Allocation) ──
        const donutCtx = document.getElementById('allocationChart').getContext('2d');
        new Chart(donutCtx, {
            type: 'doughnut',
            data: { labels, datasets: [{ data: values, backgroundColor: sliceColors, borderWidth: 2, borderColor: 'rgba(0,0,0,0.3)', hoverOffset: 8 }] },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed.toFixed(2)} DT` } } }
            }
        });

        // ── Legend ──
        const legend = document.getElementById('chartLegend');
        labels.forEach((l, i) => {
            const row = document.createElement('div');
            row.style.cssText = 'display:flex;justify-content:space-between;align-items:center;font-size:0.82rem;';
            row.innerHTML = `<div style="display:flex;align-items:center;gap:8px;"><div style="width:10px;height:10px;border-radius:50%;background:${sliceColors[i]}"></div>${l}</div><span style="color:${sliceColors[i]};font-weight:600">${values[i].toFixed(2)} DT</span>`;
            legend.appendChild(row);
        });

        // ── Bar Chart (Holdings) ──
        const barCtx = document.getElementById('holdingsChart').getContext('2d');
        new Chart(barCtx, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Quantity Held',
                    data: quantities,
                    backgroundColor: sliceColors.map(c => c + 'bb'),
                    borderColor: sliceColors,
                    borderWidth: 2,
                    borderRadius: 8,
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } },
                    x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                }
            }
        });
    })();
    </script>
    {% endif %}

    {% else %}
    <div style="text-align: center; padding: 4rem; background: var(--bg-card); border-radius: 20px;">
        <i class="fas fa-exclamation-circle" style="font-size: 3rem; color: var(--text-muted); opacity: 0.4;"></i>
        <h3 style="margin-top: 1rem; color: var(--text-muted);">Portfolio Not Found</h3>
        <p style="color: var(--text-muted);">Please contact support.</p>
    </div>
    {% endif %}

    {% endif %}
</div>

{# ── Add Portfolio Modal ── #}
<div id="addPortfolioModal" class="custom-modal">
    <div class="modal-content glass">
        <div class="modal-header">
            <h2>Create New Portfolio</h2>
            <span class="close-btn" onclick="document.getElementById('addPortfolioModal').style.display='none'">&times;</span>
        </div>
        <form action="{{ path('portfolio_create') }}" method="POST">
            <div class="form-group">
                <label>User ID</label>
                <div class="input-with-icon">
                    <i class="fas fa-id-badge"></i>
                    <input type="text" name="userId" placeholder="Enter target User ID">
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Initialize Portfolio</button>
        </form>
    </div>
</div>

{# ── Edit Portfolio Modal ── #}
<div id="editPortfolioModal" class="custom-modal">
    <div class="modal-content glass">
        <div class="modal-header">
            <h2>Edit Portfolio</h2>
            <span class="close-btn" onclick="document.getElementById('editPortfolioModal').style.display='none'">&times;</span>
        </div>
        <form id="editPortfolioForm" method="POST">
            <div class="form-group">
                <label>User ID</label>
                <div class="input-with-icon">
                    <i class="fas fa-id-badge"></i>
                    <input type="text" name="userId" id="editUserId">
                </div>
            </div>
            <div class="form-group">
                <label>Total Value (TND) [Manual Override]</label>
                <div class="input-with-icon">
                    <i class="fas fa-coins"></i>
                    <input type="text" name="totalValue" id="editTotalValue">
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Save Changes</button>
        </form>
    </div>
</div>

<script>
    function openEditModal(id, userId, totalValue) {
        document.getElementById('editPortfolioForm').action = "{{ path('portfolio_index') }}/update/" + id;
        document.getElementById('editUserId').value = userId;
        document.getElementById('editTotalValue').value = parseFloat(totalValue).toFixed(2);
        document.getElementById('editPortfolioModal').style.display = 'block';
    }

    window.onclick = function(event) {
        if (event.target.className === 'custom-modal') {
            event.target.style.display = 'none';
        }
    }
</script>
{% endblock %}
